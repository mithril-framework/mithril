func (pc *ProjectCommands) generateModuleREADME(moduleName, template string) string {
	return fmt.Sprintf("# %s Module\n\n"+
		"This module provides %s functionality for the application.\n\n"+
		"## Template: %s\n\n"+
		"## Structure\n\n"+
		"- `controllers/` - HTTP controllers\n"+
		"- `models/` - Data models\n"+
		"- `schemas/` - Request/response validation schemas\n"+
		"- `middleware/` - Custom middleware\n"+
		"- `routes/` - Route definitions\n"+
		"- `services/` - Business logic\n"+
		"- `repositories/` - Data access layer\n\n"+
		"## Usage\n\n"+
		"1. Implement your business logic in the service layer\n"+
		"2. Add your data models in the models directory\n"+
		"3. Create controllers to handle HTTP requests\n"+
		"4. Define routes in the routes directory\n"+
		"5. Add middleware if needed\n\n"+
		"## Examples\n\n"+
		"See the generated files for examples of how to implement each component.\n",
		toPascalCase(moduleName), moduleName, template)
}

// Validation functions

func isValidModuleName(name string) bool {
	if name == "" {
		return false
	}
	// Check for valid characters (alphanumeric and hyphens)
	for _, r := range name {
		if !((r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '-') {
			return false
		}
	}
	return true
}

func isValidControllerName(name string) bool {
	if name == "" {
		return false
	}
	// Check for valid characters (alphanumeric)
	for _, r := range name {
		if !((r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9')) {
			return false
		}
	}
	return true
}

func isValidModelName(name string) bool {
	return isValidControllerName(name)
}

func isValidSchemaName(name string) bool {
	return isValidControllerName(name)
}

func isValidMiddlewareName(name string) bool {
	return isValidControllerName(name)
}

func isValidCommandName(name string) bool {
	return isValidControllerName(name)
}

