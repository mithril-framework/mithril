PORT=4000
APP_NAME=mithril-rev
JWT_SECRET=your-secret-change-in-production

# Set to true to allow POST /auth/register; when unset or false, registration is disabled (app cannot create users via API).
# ENABLE_REGISTER=true

# Set to true to enable gzip response compression.
# ENABLE_COMPRESSION=true

# Set to true to enable Helmet security headers (XSS, nosniff, X-Frame-Options, etc.).
# ENABLE_HELMET=true

# PostgreSQL (optional; if unset, app runs without DB)
DATABASE_URL=postgres://user:password@localhost:5432/mithril_rev?sslmode=disable
# Or use separate vars (app and make migrate-* use DATABASE_URL when set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=mithril_rev
# DB_SSLMODE=disable
