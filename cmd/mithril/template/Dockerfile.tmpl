# Single static binary: migrations (and any embedded views/assets) are inside it.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
ENV APP_ENV=production PORT=4000
EXPOSE 4000
USER nonroot
ENTRYPOINT ["/app"]
# Run migrations as a release step: docker run --env-file .env IMAGE migrate up
