#!/bin/bash

# Mithril Artisan CLI
# Local command-line interface for Mithril applications

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored output
print_color() {
    printf "${1}${2}${NC}\n"
}

# Check if Go is installed
check_go() {
    if ! command -v go &> /dev/null; then
        print_color $RED "Error: Go is not installed or not in PATH"
        exit 1
    fi
}

# Check if we're in a Mithril project
check_project() {
    if [ ! -f "main.go" ] || [ ! -f "go.mod" ]; then
        print_color $RED "Error: Not in a Mithril project directory"
        print_color $YELLOW "Make sure you're in the root directory of your Mithril project"
        exit 1
    fi
}

# Show help
show_help() {
    print_color $BLUE "Mithril Artisan CLI"
    echo ""
    echo "Usage: ./artisan [command] [options]"
    echo ""
    echo "Available commands:"
    echo "  make:controller <name>     Create a new controller"
    echo "  make:model <name>          Create a new model"
    echo "  make:middleware <name>     Create a new middleware"
    echo "  make:module <name>         Create a new module [--full|--api-only|--web-only]"
	echo "  make:auth                  Scaffold authentication"
	echo "  createsuperuser            Create a superuser account"
    echo "  migrate                    Run database migrations (GORM AutoMigrate)"
    echo "  db:seed                    Seed the database"
    echo "  serve                      Start the development server"
    echo "  routes:list                List all routes"
            echo "  storage:backup              Backup storage to tar.gz"
            echo "  storage:link                Create public storage symlink (placeholder)"
    echo "  make:mail <name>           Create a new mail template"
    echo "  mail:test <email>          Send a test email"
    echo "  queue:work [queue]         Start queue worker"
    echo "  queue:failed [limit]       List failed jobs"
    echo "  queue:retry <job-id>       Retry a failed job"
    echo "  schedule:run               Run scheduled tasks"
    echo "  schedule:list              List scheduled tasks"
    echo "  help                       Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./artisan make:controller UserController"
    echo "  ./artisan make:model User"
    echo "  ./artisan migrate"
    echo "  ./artisan serve"
}

