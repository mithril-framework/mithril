package cli

import (
	"fmt"
	"path/filepath"
	"strings"

	"github.com/urfave/cli/v2"
)

// ProjectCommands contains all project-related commands
type ProjectCommands struct{}

// NewProjectCommands creates a new project commands instance
func NewProjectCommands() *ProjectCommands {
	return &ProjectCommands{}
}

// Register registers all project commands
func (pc *ProjectCommands) Register() {
	// make:module command
	NewCommand("make:module", "Create a new module").
		Description("Create a new module (Django-style app) with optional CRUD scaffolding").
		Category("Project").
		StringFlag("template", "full", "Module template (full, api-only, web-only)").
		BoolFlag("controller", "Include controller").
		BoolFlag("model", "Include model").
		BoolFlag("routes", "Include routes").
		BoolFlag("middleware", "Include middleware").
		Action(pc.MakeModule).
		Register()

	// make:controller command
	NewCommand("make:controller", "Create a new controller").
		Description("Create a new controller with optional resource methods").
		Category("Project").
		StringFlag("template", "basic", "Controller template (basic, resource, auth, api, web)").
		BoolFlag("resource", "Create resource controller with CRUD methods").
		BoolFlag("auth", "Create authentication controller").
		BoolFlag("api", "Create API controller").
		BoolFlag("web", "Create web controller").
		Action(pc.MakeController).
		Register()

	// make:model command
	NewCommand("make:model", "Create a new model").
		Description("Create a new model with optional migration and seeder").
		Category("Project").
		BoolFlag("migration", "Create migration file").
		BoolFlag("seeder", "Create seeder file").
		BoolFlag("factory", "Create factory file").
		BoolFlag("soft-deletes", "Include soft deletes").
		BoolFlag("timestamps", "Include timestamps").
		Action(pc.MakeModel).
		Register()

	// make:schema command
	NewCommand("make:schema", "Create a new schema").
		Description("Create a new schema for request/response validation").
		Category("Project").
		StringFlag("type", "request", "Schema type (request, response, both)").
		BoolFlag("validation", "Include validation tags").
		Action(pc.MakeSchema).
		Register()

	// make:middleware command
	NewCommand("make:middleware", "Create a new middleware").
		Description("Create a new middleware with basic structure").
		Category("Project").
		StringFlag("template", "basic", "Middleware template (basic, auth, cors, rate-limit)").
		Action(pc.MakeMiddleware).
		Register()

	// make:command command
	NewCommand("make:command", "Create a new console command").
		Description("Create a new console command with basic structure").
		Category("Project").
		StringFlag("template", "basic", "Command template (basic, scheduled, queue)").
		Action(pc.MakeCommand).
		Register()
}

// MakeModule creates a new module
func (pc *ProjectCommands) MakeModule(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("module name is required")
	}

	moduleName := cc.GetStringArg(0)
	template := cc.GetStringFlag("template")
	includeController := cc.GetBoolFlag("controller")
	includeModel := cc.GetBoolFlag("model")
	includeRoutes := cc.GetBoolFlag("routes")
	includeMiddleware := cc.GetBoolFlag("middleware")

	// Validate module name
	if !isValidModuleName(moduleName) {
		return fmt.Errorf("invalid module name: %s", moduleName)
	}

	// Check if module already exists
	modulePath := filepath.Join("app", "modules", moduleName)
	if cc.DirectoryExists(modulePath) {
		return fmt.Errorf("module '%s' already exists", moduleName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating module '%s' with template '%s'", moduleName, template))

	// Create module directory structure
	directories := []string{
		modulePath,
		filepath.Join(modulePath, "controllers"),
		filepath.Join(modulePath, "models"),
		filepath.Join(modulePath, "schemas"),
		filepath.Join(modulePath, "middleware"),
		filepath.Join(modulePath, "routes"),
		filepath.Join(modulePath, "services"),
		filepath.Join(modulePath, "repositories"),
	}

	for _, dir := range directories {
		if err := cc.CreateDirectory(dir); err != nil {
			return fmt.Errorf("failed to create directory %s: %w", dir, err)
		}
	}

	// Create module files based on template
	switch template {
	case "full":
		if err := pc.createFullModule(cc, moduleName, modulePath, includeController, includeModel, includeRoutes, includeMiddleware); err != nil {
			return err
		}
	case "api-only":
		if err := pc.createAPIOnlyModule(cc, moduleName, modulePath, includeController, includeModel, includeRoutes, includeMiddleware); err != nil {
			return err
		}
	case "web-only":
		if err := pc.createWebOnlyModule(cc, moduleName, modulePath, includeController, includeModel, includeRoutes, includeMiddleware); err != nil {
			return err
		}
	default:
		return fmt.Errorf("unknown template: %s", template)
	}

	// Create README
	if err := pc.createModuleREADME(cc, moduleName, modulePath, template); err != nil {
		return err
	}

	cc.PrintSuccess(fmt.Sprintf("Module '%s' created successfully", moduleName))
	cc.PrintInfo(fmt.Sprintf("Module path: %s", modulePath))

	return nil
}

// MakeController creates a new controller
func (pc *ProjectCommands) MakeController(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("controller name is required")
	}

	controllerName := cc.GetStringArg(0)
	template := cc.GetStringFlag("template")
	isResource := cc.GetBoolFlag("resource")
	isAuth := cc.GetBoolFlag("auth")
	isAPI := cc.GetBoolFlag("api")
	isWeb := cc.GetBoolFlag("web")

	// Determine template based on flags
	if isResource {
		template = "resource"
	} else if isAuth {
		template = "auth"
	} else if isAPI {
		template = "api"
	} else if isWeb {
		template = "web"
	}

	// Validate controller name
	if !isValidControllerName(controllerName) {
		return fmt.Errorf("invalid controller name: %s", controllerName)
	}

	// Determine controller path
	controllerPath := filepath.Join("app", "controllers", toSnakeCase(controllerName)+"_controller.go")

	// Check if controller already exists
	if cc.FileExists(controllerPath) {
		return fmt.Errorf("controller '%s' already exists", controllerName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating controller '%s' with template '%s'", controllerName, template))

	// Create controller based on template
	switch template {
	case "resource":
		if err := pc.createResourceController(cc, controllerName, controllerPath); err != nil {
			return err
		}
	case "auth":
		if err := pc.createAuthController(cc, controllerName, controllerPath); err != nil {
			return err
		}
	case "api":
		if err := pc.createAPIController(cc, controllerName, controllerPath); err != nil {
			return err
		}
	case "web":
		if err := pc.createWebController(cc, controllerName, controllerPath); err != nil {
			return err
		}
	default:
		if err := pc.createBasicController(cc, controllerName, controllerPath); err != nil {
			return err
		}
	}

	cc.PrintSuccess(fmt.Sprintf("Controller '%s' created successfully", controllerName))
	cc.PrintInfo(fmt.Sprintf("Controller path: %s", controllerPath))

	return nil
}

// MakeModel creates a new model
func (pc *ProjectCommands) MakeModel(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("model name is required")
	}

	modelName := cc.GetStringArg(0)
	createMigration := cc.GetBoolFlag("migration")
	createSeeder := cc.GetBoolFlag("seeder")
	createFactory := cc.GetBoolFlag("factory")
	includeSoftDeletes := cc.GetBoolFlag("soft-deletes")
	includeTimestamps := cc.GetBoolFlag("timestamps")

	// Validate model name
	if !isValidModelName(modelName) {
		return fmt.Errorf("invalid model name: %s", modelName)
	}

	// Create model file
	modelPath := filepath.Join("app", "models", toSnakeCase(modelName)+".go")

	// Check if model already exists
	if cc.FileExists(modelPath) {
		return fmt.Errorf("model '%s' already exists", modelName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating model '%s'", modelName))

	// Create model
	if err := pc.createModel(cc, modelName, modelPath, includeSoftDeletes, includeTimestamps); err != nil {
		return err
	}

	// Create migration if requested
	if createMigration {
		if err := pc.createModelMigration(cc, modelName); err != nil {
			return err
		}
	}

	// Create seeder if requested
	if createSeeder {
		if err := pc.createModelSeeder(cc, modelName); err != nil {
			return err
		}
	}

	// Create factory if requested
	if createFactory {
		if err := pc.createModelFactory(cc, modelName); err != nil {
			return err
		}
	}

	cc.PrintSuccess(fmt.Sprintf("Model '%s' created successfully", modelName))
	cc.PrintInfo(fmt.Sprintf("Model path: %s", modelPath))

	return nil
}

// MakeSchema creates a new schema
func (pc *ProjectCommands) MakeSchema(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("schema name is required")
	}

	schemaName := cc.GetStringArg(0)
	schemaType := cc.GetStringFlag("type")
	includeValidation := cc.GetBoolFlag("validation")

	// Validate schema name
	if !isValidSchemaName(schemaName) {
		return fmt.Errorf("invalid schema name: %s", schemaName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating schema '%s' of type '%s'", schemaName, schemaType))

	// Create schema files based on type
	switch schemaType {
	case "request":
		if err := pc.createRequestSchema(cc, schemaName, includeValidation); err != nil {
			return err
		}
	case "response":
		if err := pc.createResponseSchema(cc, schemaName, includeValidation); err != nil {
			return err
		}
	case "both":
		if err := pc.createRequestSchema(cc, schemaName, includeValidation); err != nil {
			return err
		}
		if err := pc.createResponseSchema(cc, schemaName, includeValidation); err != nil {
			return err
		}
	default:
		return fmt.Errorf("unknown schema type: %s", schemaType)
	}

	cc.PrintSuccess(fmt.Sprintf("Schema '%s' created successfully", schemaName))

	return nil
}

// MakeMiddleware creates a new middleware
func (pc *ProjectCommands) MakeMiddleware(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("middleware name is required")
	}

	middlewareName := cc.GetStringArg(0)
	template := cc.GetStringFlag("template")

	// Validate middleware name
	if !isValidMiddlewareName(middlewareName) {
		return fmt.Errorf("invalid middleware name: %s", middlewareName)
	}

	// Create middleware file
	middlewarePath := filepath.Join("app", "middleware", toSnakeCase(middlewareName)+".go")

	// Check if middleware already exists
	if cc.FileExists(middlewarePath) {
		return fmt.Errorf("middleware '%s' already exists", middlewareName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating middleware '%s' with template '%s'", middlewareName, template))

	// Create middleware based on template
	switch template {
	case "auth":
		if err := pc.createAuthMiddleware(cc, middlewareName, middlewarePath); err != nil {
			return err
		}
	case "cors":
		if err := pc.createCORSMiddleware(cc, middlewareName, middlewarePath); err != nil {
			return err
		}
	case "rate-limit":
		if err := pc.createRateLimitMiddleware(cc, middlewareName, middlewarePath); err != nil {
			return err
		}
	default:
		if err := pc.createBasicMiddleware(cc, middlewareName, middlewarePath); err != nil {
			return err
		}
	}

	cc.PrintSuccess(fmt.Sprintf("Middleware '%s' created successfully", middlewareName))
	cc.PrintInfo(fmt.Sprintf("Middleware path: %s", middlewarePath))

	return nil
}

// MakeCommand creates a new console command
func (pc *ProjectCommands) MakeCommand(ctx *cli.Context) error {
	cc := NewCommandContext(ctx.App, ctx)

	if len(cc.Args) == 0 {
		return fmt.Errorf("command name is required")
	}

	commandName := cc.GetStringArg(0)
	template := cc.GetStringFlag("template")

	// Validate command name
	if !isValidCommandName(commandName) {
		return fmt.Errorf("invalid command name: %s", commandName)
	}

	// Create command file
	commandPath := filepath.Join("app", "commands", toSnakeCase(commandName)+".go")

	// Check if command already exists
	if cc.FileExists(commandPath) {
		return fmt.Errorf("command '%s' already exists", commandName)
	}

	cc.PrintInfo(fmt.Sprintf("Creating command '%s' with template '%s'", commandName, template))

	// Create command based on template
	switch template {
	case "scheduled":
		if err := pc.createScheduledCommand(cc, commandName, commandPath); err != nil {
			return err
		}
	case "queue":
		if err := pc.createQueueCommand(cc, commandName, commandPath); err != nil {
			return err
		}
	default:
		if err := pc.createBasicCommand(cc, commandName, commandPath); err != nil {
			return err
		}
	}

	cc.PrintSuccess(fmt.Sprintf("Command '%s' created successfully", commandName))
	cc.PrintInfo(fmt.Sprintf("Command path: %s", commandPath))

	return nil
}

// Helper functions for creating files

func (pc *ProjectCommands) createFullModule(cc *CommandContext, moduleName, modulePath string, includeController, includeModel, includeRoutes, includeMiddleware bool) error {
	// Create main module file
	moduleFile := filepath.Join(modulePath, "module.go")
	content := pc.generateModuleFile(moduleName, "full")
	if err := cc.WriteFile(moduleFile, []byte(content)); err != nil {
		return err
	}

	// Create routes file
	if includeRoutes {
		routesFile := filepath.Join(modulePath, "routes", "routes.go")
		content := pc.generateRoutesFile(moduleName)
		if err := cc.WriteFile(routesFile, []byte(content)); err != nil {
			return err
		}
	}

	// Create service file
	serviceFile := filepath.Join(modulePath, "services", toSnakeCase(moduleName)+"_service.go")
	content = pc.generateServiceFile(moduleName)
	if err := cc.WriteFile(serviceFile, []byte(content)); err != nil {
		return err
	}

	// Create repository file
	repositoryFile := filepath.Join(modulePath, "repositories", toSnakeCase(moduleName)+"_repository.go")
	content = pc.generateRepositoryFile(moduleName)
	if err := cc.WriteFile(repositoryFile, []byte(content)); err != nil {
		return err
	}

	return nil
}

func (pc *ProjectCommands) createAPIOnlyModule(cc *CommandContext, moduleName, modulePath string, includeController, includeModel, includeRoutes, includeMiddleware bool) error {
	// Create main module file
	moduleFile := filepath.Join(modulePath, "module.go")
	content := pc.generateModuleFile(moduleName, "api-only")
	if err := cc.WriteFile(moduleFile, []byte(content)); err != nil {
		return err
	}

	// Create API routes file
	if includeRoutes {
		routesFile := filepath.Join(modulePath, "routes", "api.go")
		content := pc.generateAPIRoutesFile(moduleName)
		if err := cc.WriteFile(routesFile, []byte(content)); err != nil {
			return err
		}
	}

	return nil
}

func (pc *ProjectCommands) createWebOnlyModule(cc *CommandContext, moduleName, modulePath string, includeController, includeModel, includeRoutes, includeMiddleware bool) error {
	// Create main module file
	moduleFile := filepath.Join(modulePath, "module.go")
	content := pc.generateModuleFile(moduleName, "web-only")
	if err := cc.WriteFile(moduleFile, []byte(content)); err != nil {
		return err
	}

	// Create web routes file
	if includeRoutes {
		routesFile := filepath.Join(modulePath, "routes", "web.go")
		content := pc.generateWebRoutesFile(moduleName)
		if err := cc.WriteFile(routesFile, []byte(content)); err != nil {
			return err
		}
	}

	return nil
}

func (pc *ProjectCommands) createModuleREADME(cc *CommandContext, moduleName, modulePath, template string) error {
	readmeFile := filepath.Join(modulePath, "README.md")
	content := pc.generateModuleREADME(moduleName, template)
	return cc.WriteFile(readmeFile, []byte(content))
}

// Template generation functions

func (pc *ProjectCommands) generateModuleFile(moduleName, template string) string {
	tmpl := `package {{.PackageName}}

import (
	"github.com/gofiber/fiber/v2"
)

// {{.ModuleName}} represents the {{.ModuleName}} module
type {{.ModuleName}} struct {
	app *fiber.App
}

// New{{.ModuleName}} creates a new {{.ModuleName}} module
func New{{.ModuleName}}(app *fiber.App) *{{.ModuleName}} {
	return &{{.ModuleName}}{
		app: app,
	}
}

// Register registers the module routes
func (m *{{.ModuleName}}) Register() {
	// Register module routes here
}

// GetName returns the module name
func (m *{{.ModuleName}}) GetName() string {
	return "{{.ModuleName}}"
}

// GetVersion returns the module version
func (m *{{.ModuleName}}) GetVersion() string {
	return "1.0.0"
}
`

	t := template.Must(template.New("module").Parse(tmpl))

	var buf strings.Builder
	err := t.Execute(&buf, map[string]string{
		"PackageName": toSnakeCase(moduleName),
		"ModuleName":  toPascalCase(moduleName),
	})
	if err != nil {
		return ""
	}

	return buf.String()
}

func (pc *ProjectCommands) generateRoutesFile(moduleName string) string {
	return fmt.Sprintf(`package routes

import (
	"github.com/gofiber/fiber/v2"
)

// Register{{.ModuleName}}Routes registers the {{.ModuleName}} routes
func Register{{.ModuleName}}Routes(app *fiber.App) {
	// Add your routes here
}
`, toPascalCase(moduleName))
}

func (pc *ProjectCommands) generateAPIRoutesFile(moduleName string) string {
	return fmt.Sprintf(`package routes

import (
	"github.com/gofiber/fiber/v2"
)

// Register{{.ModuleName}}APIRoutes registers the {{.ModuleName}} API routes
func Register{{.ModuleName}}APIRoutes(app *fiber.App) {
	api := app.Group("/api/v1")
	
	// Add your API routes here
	api.Get("/{{.ModuleName}}", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{"message": "{{.ModuleName}} API"})
	})
}
`, toPascalCase(moduleName), toSnakeCase(moduleName))
}

func (pc *ProjectCommands) generateWebRoutesFile(moduleName string) string {
	return fmt.Sprintf(`package routes

import (
	"github.com/gofiber/fiber/v2"
)

// Register{{.ModuleName}}WebRoutes registers the {{.ModuleName}} web routes
func Register{{.ModuleName}}WebRoutes(app *fiber.App) {
	// Add your web routes here
	app.Get("/{{.ModuleName}}", func(c *fiber.Ctx) error {
		return c.Render("{{.ModuleName}}/index", fiber.Map{
			"title": "{{.ModuleName}}",
		})
	})
}
`, toPascalCase(moduleName), toSnakeCase(moduleName))
}

