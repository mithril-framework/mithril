PORT=4000
APP_NAME=mithril
JWT_SECRET=your-secret-change-in-production

# CORS allowed origins (comma-separated). Default: http://localhost:3000,http://localhost:4000
# CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Set to production to require JWT_SECRET and a working database when DB_* is set
# APP_ENV=production

# Set to true to allow POST /auth/register; when unset or false, registration is disabled.
# ENABLE_REGISTER=true

# Set to true to enable gzip response compression.
# ENABLE_COMPRESSION=true

# Set to true to enable Helmet security headers (XSS, nosniff, X-Frame-Options, etc.).
# ENABLE_HELMET=true

# Admin panel: ENABLE_ADMIN_PANEL=true or touch .admin-panel-enabled (see Makefile admin-enable).

# Embedded PostgreSQL web UI: ENABLE_DBMS=true or touch .dbms-enabled; then `make dbms`.
# Listens on :5050 by default (pgAdmin in docker-compose uses :5051 to avoid conflict).
# ENABLE_DBMS=true
# DBMS_ADDR=:5050

# PostgreSQL — matches `make dc-up-postgres` (trust auth, database mithril_rev).
# Comment out DB_HOST to run without a database (/, /health, /docs still work).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mithril_rev
DB_SSLMODE=disable

# Or use a single URL instead of DB_* (takes precedence when set):
# DATABASE_URL=postgres://postgres@localhost:5432/mithril_rev?sslmode=disable
