APP_NAME={{.Name}}
# development | production. When unset the server behaves as production (JWT_SECRET required).
APP_ENV=development
PORT=4000
# >= 32 random bytes in production: openssl rand -base64 32
JWT_SECRET={{.Secret}}

# PostgreSQL (docker compose up -d starts one matching these values)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.DBName}}
DB_SSLMODE=disable
# Or a single URL (takes precedence): DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.DBName}}?sslmode=disable

# CORS_ORIGINS=http://localhost:3000
# ENABLE_REGISTER=true        # allow POST /auth/register
ENABLE_ADMIN_PANEL=true       # Django-style admin at /admin
# ENABLE_DOCS=true            # Swagger UI at /docs (on by default in development)
# ENABLE_MONITOR=true         # /monitor dashboard (superusers only)
# ENABLE_HELMET=false         # security headers are on by default

# --- Performance: defaults are tuned for production (docs: /docs/core/performance)
# LOG_REQUESTS=errors         # errors (default: status >= 400) | all | none. Logging every request costs ~6% CPU.
# TRUST_PROXY=true            # client IP from PROXY_HEADER, honoured only when the peer is loopback/private
# PROXY_HEADER=X-Real-IP
# DB_MAX_CONNS=               # default: 4 per CPU, between 10 and 50
# READ_TIMEOUT=30s
# WRITE_TIMEOUT=30s
# IDLE_TIMEOUT=120s
# BODY_LIMIT=4194304
# PPROF_ADDR=127.0.0.1:6060   # private profiler while load testing; never a public address
# PREFORK=false               # one process per CPU: Linux + stateless apps only
# HIGH_THROUGHPUT=false       # drop Date/default Content-Type headers (stateless hot services)
