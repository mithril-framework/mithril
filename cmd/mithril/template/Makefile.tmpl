.PHONY: run test build migrate db routes openapi bench profile

run:      ## Start the server
	go run .
test:     ## Run tests
	go test ./...
build:    ## Build a single self-contained binary
	CGO_ENABLED=0 go build -trimpath -o bin/{{.Name}} .
db:       ## Start PostgreSQL in Docker
	docker compose up -d postgres
migrate:  ## Apply migrations
	go run . migrate up
routes:   ## List routes
	go run . routes
openapi:  ## Write openapi.json
	go run . openapi -o openapi.json
bench:    ## Keep-alive load test (needs oha). make bench URL=http://127.0.0.1:4000/hello C=64 D=15s
	oha -z $(or $(D),15s) -c $(or $(C),64) --no-tui $(or $(URL),http://127.0.0.1:4000/hello)
profile:  ## 30 s CPU profile of a server started with PPROF_ADDR=127.0.0.1:6060 (run during a load test)
	curl -s -o cpu.pprof "http://127.0.0.1:6060/debug/pprof/profile?seconds=30" && go tool pprof -top -nodecount=30 cpu.pprof
