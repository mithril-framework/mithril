# Storage
# Backend: s3 or minio (required)
STORAGE_BACKEND=

# S3 configuration
S3_REGION=us-east-1
S3_BUCKET=
# Optional custom endpoint (for VPC endpoints or S3-compatible services)
S3_ENDPOINT=
# true to force path-style URLs (useful with custom endpoints)
S3_FORCE_PATH_STYLE=false

# MinIO configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=
MINIO_REGION=us-east-1

# Mail configuration
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM_NAME=Mithril
MAIL_FROM_ADDRESS=noreply@example.com
# Application Configuration
APP_NAME=myproject7
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET=your-secret-key-change-in-production
APP_TIMEZONE=UTC

# Server Configuration
HOST=localhost
PORT=4000

# Database Configuration (Default)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mithril
DB_USER=mithril
DB_PASSWORD=password
DB_SSLMODE=disable
DB_CHARSET=utf8mb4
DB_TIMEZONE=UTC

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mithril
POSTGRES_USER=mithril
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=mithril
MYSQL_USER=mithril
MYSQL_PASSWORD=password
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=UTC

# SQLite Configuration
SQLITE_DB=./database.sqlite

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=mithril
MONGODB_USER=
MONGODB_PASSWORD=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=24h
JWT_ALGORITHM=HS256

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_EXPIRY=24h
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# CORS Configuration
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,Content-Type,Accept,Authorization

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="myproject7"

# Queue Configuration
QUEUE_DRIVER=memory
QUEUE_CONNECTION=default
QUEUE_PREFIX=mithril:queue
QUEUE_TIMEOUT=5m
QUEUE_RETRIES=3

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_DISK=local
STORAGE_PATH=./storage

# S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mithril
MINIO_SSL=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# Monitoring Configuration
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8080
WEBSOCKET_PATH=/ws
WEBSOCKET_READ_BUFFER=1024
WEBSOCKET_WRITE_BUFFER=1024
WEBSOCKET_MAX_MESSAGE_SIZE=524288
WEBSOCKET_PING_INTERVAL=54
WEBSOCKET_PONG_TIMEOUT=60

# gRPC Configuration
GRPC_ENABLED=false
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304
GRPC_REFLECTION=true
