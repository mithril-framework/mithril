# Make mail template
make_mail() {
    local name=$1
    if [ -z "$name" ]; then
        print_color $RED "Error: Mail template name is required"
        echo "Usage: ./artisan make:mail <name>"
        exit 1
    fi
    
    print_color $YELLOW "Creating mail template: $name"
    mkdir -p app/mail
    
    cat > "app/mail/${name,,}.go" <<EOF
package mail

import (
    "context"
    "github.com/mithril-framework/mithril/pkg/mail"
)

// ${name} sends a ${name,,} email
func ${name}(mailer *mail.Mailer, to string, data map[string]interface{}) error {
    subject := "Your Subject Here"
    text := "Plain text version of your email"
    html := "<h1>HTML version</h1><p>Your email content here</p>"
    
    return mailer.Send(context.Background(), to, subject, text, html)
}
EOF
    
    print_color $GREEN "Mail template created: app/mail/${name,,}.go"
}

# Send test email
mail_test() {
    local email=$1
    if [ -z "$email" ]; then
        print_color $RED "Error: Email address is required"
        echo "Usage: ./artisan mail:test <email>"
        exit 1
    fi
    
    print_color $YELLOW "Sending test email to: $email"
    print_color $YELLOW "Make sure your MAIL_* env vars are set (see .env.example)"
    print_color $YELLOW "For Mailhog: MAIL_HOST=localhost MAIL_PORT=1025"
    
    # Use curl to test endpoint if example-mail is running
    if command -v curl >/dev/null 2>&1; then
        curl -X POST "http://localhost:3002/send-test" \
            -H "Content-Type: application/json" \
            -d "{\"to\":\"$email\"}" 2>/dev/null && \
            print_color $GREEN "Test email sent! Check Mailhog at http://localhost:8025" || \
            print_color $RED "Failed to send. Is example-mail running? (go run example-mail/main.go)"
    else
        print_color $RED "curl not found. Install curl or run: go run example-mail/main.go"
    fi
}

