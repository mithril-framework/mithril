#!/usr/bin/env sh
# mithril: project CLI wrapper. Prefers global Go binary; falls back to make in repo root.
set -e

script="$0"
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script="$target" ;;
    *) script="$(dirname "$script")/$target" ;;
  esac
done
root=$(cd "$(dirname "$script")" && pwd)

if command -v mithril >/dev/null 2>&1; then
  case "$1" in
    new|init|--version|-v|version|ping|help|--help|-h)
      exec mithril "$@"
      ;;
    createsuperuser)
      shift
      cd "$root" && exec go run ./cmd/createsuperuser "$@"
      ;;
  esac
  if [ -f "$root/go.mod" ] && grep -q 'github.com/mithril-framework/mithril' "$root/go.mod" 2>/dev/null; then
    cd "$root" && exec mithril "$@"
  fi
fi

cd "$root" && exec make "$@"
