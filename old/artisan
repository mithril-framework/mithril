# Create module
make_module() {
    local module_name=$1
    local flags=""
    
    # Parse additional arguments for flags
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            --full|-f)
                flags="--full"
                ;;
            --api-only|-a)
                flags="--api-only"
                ;;
            --web-only|-w)
                flags="--web-only"
                ;;
            *)
                # Unknown option
                ;;
        esac
        shift
    done
    
    if [ -z "$module_name" ]; then
        print_color $RED "Error: Module name is required"
        print_color $YELLOW "Usage: ./artisan make:module <name> [--full|--api-only|--web-only]"
        return 1
    fi
    
    print_color $YELLOW "Creating module: $module_name"
    if [ -n "$flags" ]; then
        print_color $BLUE "Flags: $flags"
    fi
    
    # Call the global mithril CLI
    ../../mithril-cli make module $module_name $flags
}

