PORT=4000
APP_NAME=mithril
JWT_SECRET=your-secret-change-in-production

# CORS allowed origins (comma-separated). Default: http://localhost:3000,http://localhost:4000
# CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Set to production to require JWT_SECRET
# APP_ENV=production

# Set to true to allow POST /auth/register; when unset or false, registration is disabled.
# ENABLE_REGISTER=true

# Set to true to enable gzip response compression.
# ENABLE_COMPRESSION=true

# Set to true to enable Helmet security headers (XSS, nosniff, X-Frame-Options, etc.).
# ENABLE_HELMET=true

# Admin panel: ENABLE_ADMIN_PANEL=true or touch .admin-panel-enabled (see Makefile admin-enable).

# Embedded PostgreSQL web UI (Adminer-style): ENABLE_DBMS=true or touch .dbms-enabled; then `make dbms`.
# Default listen address :5050; override with DBMS_ADDR=:9090 (legacy: ADDR is also read if DBMS_ADDR is empty).
# ENABLE_DBMS=true
# DBMS_ADDR=:5050

# PostgreSQL (optional; if unset, app runs without DB)
DATABASE_URL=postgres://user:password@localhost:5432/mithril_rev?sslmode=disable
# Or use separate vars (app and make migrate-* use DATABASE_URL when set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=mithril_rev
# DB_SSLMODE=disable
